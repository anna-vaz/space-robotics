<?xml version="1.0"?>
<!-- Empty world with ZERO gravity: an orbiting spacecraft is in free fall, so
     in its own frame gravity effectively vanishes (orbital/tidal effects are
     negligible over a few seconds of manipulation). -->
<sdf version="1.9">
  <world name="zero_g">
    <gravity>0 0 0</gravity>
    <magnetic_field>0 0 0</magnetic_field>
    <atmosphere type="adiabatic"/>  <!-- no drag is modelled in gz-sim anyway -->

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>   <!-- 1 kHz, same rate as the controllers -->
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.02 0.02 0.06 1</background>  <!-- space -->
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>
  </world>
</sdf>
