! Random vibration (PSD) of the idealised CubeSat_3U_v5 model, GEVS qualification (GSFC-STD-7000B), one axis.
! Set by run.py: DIR (1 = X, 2 = Y, 3 = Z), NMODE (max modes), FMAXM (modal upper bound, Hz), ZETA
! Both rail ends fixed (same as SOLIDWORKS StepRV); all fixed nodes driven together (base excitation).
/nopr
/input,model,inp
/gopr
/solu
antype,modal
modopt,lanb,NMODE,0,FMAXM
mxpand,NMODE,,,yes
cmsel,s,RAILENDS
d,all,all,0
allsel
solve
*get,nfound,active,0,solu,ncmss
finish
/solu
antype,spectr
spopt,psd,NMODE,on
psdunit,1,accg,9.80665
! input ASD (g^2/Hz); MAPDL interpolates log-log; 3000 Hz point = GEVS -6 dB/oct continued
psdfrq,1,,20,50,800,2000,3000
psdval,1,0.026,0.16,0.16,0.026,0.0116
dmprat,ZETA
cmsel,s,RAILENDS
*if,DIR,eq,1,then
  d,all,ux,1.0
*elseif,DIR,eq,2
  d,all,uy,1.0
*else
  d,all,uz,1.0
*endif
allsel
pfact,1,base
psdres,disp,rel
psdres,velo,off
psdres,acel,abs
psdcom,0.0001
solve
finish
! ------------------------------------------------------------------ 1-sigma results
/post1
set,list
set,3,1                      ! 1-sigma displacement / stress / forces
allsel
nsort,u,sum
*get,umax,sort,0,max
/com,RES UMAX_MM %umax*1000%
! shells: max 1-sigma von Mises per material (one material per part)
*get,nmat,mat,0,num,max
*do,m,1,nmat
  esel,s,mat,,m
  esel,r,ename,,181
  *get,ne,elem,0,count
  *if,ne,gt,0,then
    nsle,s
    nsort,s,eqv
    *get,smx,sort,0,max
    *get,snd,sort,0,imax
    /com,SHELLMAT %m% %smx/1e6% %snd%
  *endif
*enddo
allsel
! beams: 1-sigma end forces/moments (I and J ends)
esel,s,ename,,188
etable,FXI,smisc,1
etable,MYI,smisc,2
etable,MZI,smisc,3
etable,SZI,smisc,5
etable,SYI,smisc,6
etable,FXJ,smisc,14
etable,MYJ,smisc,15
etable,MZJ,smisc,16
etable,SZJ,smisc,18
etable,SYJ,smisc,19
*get,e0,elem,0,num,min
*get,e1,elem,0,num,max
*cfopen,beams,csv
*vwrite
('elem,FXI,MYI,MZI,SZI,SYI,FXJ,MYJ,MZJ,SZJ,SYJ')
*do,e,e0,e1
  *get,a1,elem,e,etab,FXI
  *get,a2,elem,e,etab,MYI
  *get,a3,elem,e,etab,MZI
  *get,a4,elem,e,etab,SZI
  *get,a5,elem,e,etab,SYI
  *get,b1,elem,e,etab,FXJ
  *get,b2,elem,e,etab,MYJ
  *get,b3,elem,e,etab,MZJ
  *get,b4,elem,e,etab,SZJ
  *get,b5,elem,e,etab,SYJ
  *vwrite,e,a1,a2,a3,a4,a5,b1,b2,b3,b4,b5
  (F8.0,10(',',E14.6))
*enddo
*cfclose
allsel
! 1-sigma absolute acceleration at the point masses (g)
set,list
*get,nset,active,0,set,nset
set,last
esel,s,ename,,21
*get,em0,elem,0,num,min
*get,em1,elem,0,num,max
*do,e,em0,em1
  *get,nn,elem,e,node,1
  *get,ax,node,nn,a,x
  *get,ay,node,nn,a,y
  *get,az,node,nn,a,z
  /com,MASSACC %e% %ax/9.80665% %ay/9.80665% %az/9.80665%
*enddo
finish
